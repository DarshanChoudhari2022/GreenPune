# Site URL configuration
NEXT_PUBLIC_SITE_URL=https://greenpune.in

# Supabase (Optional for cloud registrations storage; falls back to local data/registrations.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=event_registrations
SUPABASE_EVENTS_TABLE=

# Admin Dashboard
ADMIN_PASSWORD=greenpune-admin

# Web3Forms (Optional: email notifications for new volunteer registrations)
WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 (Optional: Disabled unless supplied and accepted by visitor)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

